# Copy to `.env` for local overrides. Environment variables win over this file.
# Never put real secrets in this example file or in committed docs.

# Required for live provider calls. Leave empty for offline work.
ANTHROPIC_API_KEY=

# Provider model identifier that the Anthropic account can actually call.
# Do not invent an ID. Verify it with the provider before live preflight.
PRECEDENT_MODEL=

# SQLite path and source data directory, resolved from the repository root.
PRECEDENT_DB_PATH=var/precedent.sqlite3
PRECEDENT_DATA_DIR=data

# Positive integer budgets. Zero or negative values are rejected.
PRECEDENT_MAX_MODEL_CALLS=10
PRECEDENT_MAX_TOOL_CALLS=30
PRECEDENT_MAX_CASE_SECONDS=120
PRECEDENT_REQUEST_TIMEOUT_SECONDS=30
PRECEDENT_MAX_OUTPUT_TOKENS=1500

# Optional USD per million tokens for estimates. Empty means unknown, never zero.
PRECEDENT_INPUT_USD_PER_MILLION=
PRECEDENT_OUTPUT_USD_PER_MILLION=

# Chargeable calls stay off until this is true AND a live CLI/UI action is used.
PRECEDENT_ENABLE_LIVE=false
